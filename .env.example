# Server-only. Set in Vercel Project Settings → Environment Variables, then redeploy.
OPENAI_API_KEY=
OPENAI_README_MODEL=gpt-5-nano
# Optional comma-separated extra trusted origins; same-origin requests work by default.
README_AI_ALLOWED_ORIGINS=

# Optional server-only token for a higher GitHub API allowance. Public read access only.
GITHUB_README_TOKEN=
